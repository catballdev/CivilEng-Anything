# CivilEng-Anything configuration
# Copy to .env and adjust as needed

# Data directory (stores originals/, parsed/, assets/, civileng.db, indexes/)
CIVILENG_DATA_DIR=./data

# Embedding model for semantic search (replaceable via config)
CIVILENG_EMBED_MODEL=BAAI/bge-m3

# Default top-k for retrieval
CIVILENG_TOP_K=8

# Token budget for retrieved context
CIVILENG_TOKEN_BUDGET=6000

# API server host/port (when using the api extra)
CIVILENG_HOST=127.0.0.1
CIVILENG_API_PORT=8765